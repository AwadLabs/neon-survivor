<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a0a0f" id="metaTheme">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="صلاحية">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>صلاحية - تتبع تواريخ الانتهاء</title>
<link rel="manifest" href="./manifest.json">
<link rel="icon" type="image/svg+xml" href="./icon.svg">
<link rel="icon" type="image/png" href="./icon-192.png">
<link rel="apple-touch-icon" href="./apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<style id="pageStyle"></style>
<style>
  :root{
    --bg:#0a0a0f; --surface:#13131b; --surface-2:#1b1b26; --border:#262635;
    --text:#f2f2f7; --text-rgb:242,242,247; --muted:#8b8ba3;
    --green:#00d68f;  --green-rgb:0,214,143;
    --yellow:#ffb800; --yellow-rgb:255,184,0;
    --red:#ff4d6d;    --red-rgb:255,77,109;
    --glow:1; --radius:18px;
    --font:'Cairo','Tajawal','Segoe UI',Tahoma,'Noto Sans Arabic',Arial,sans-serif;
  }
  [data-theme="light"]{
    --bg:#f3f4f8; --surface:#ffffff; --surface-2:#eef0f5; --border:#dcdfe8;
    --text:#15151d; --text-rgb:21,21,29; --muted:#6b6b80;
    --green:#00a870;  --green-rgb:0,168,112;
    --yellow:#c98a00; --yellow-rgb:201,138,0;
    --red:#e2294b;    --red-rgb:226,41,75;
    --glow:0;
  }
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  html,body{background:var(--bg);color:var(--text);font-family:var(--font);min-height:100%}
  body{
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:calc(env(safe-area-inset-bottom,0px) + 110px);
    line-height:1.6;transition:background .3s,color .3s;
    background:radial-gradient(circle at 85% -10%, rgba(var(--green-rgb),.12), transparent 45%), var(--bg);
    background-attachment:fixed;
  }
  button,input,textarea{font-family:inherit;font-size:inherit;color:inherit}
  button{cursor:pointer;border:none;background:none}
  button:focus-visible,input:focus-visible{outline:2px solid var(--green);outline-offset:2px}
  .container{max-width:640px;margin:0 auto;padding:16px}

  header{display:flex;align-items:center;justify-content:space-between;padding:8px 0 16px;gap:8px}
  .brand{display:flex;align-items:center;gap:12px}
  .logo{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:26px;
    background:rgba(var(--green-rgb),.16);border:1px solid rgba(var(--green-rgb),.45);
    box-shadow:0 0 calc(20px * var(--glow)) rgba(var(--green-rgb),.3)}
  .brand h1{font-size:26px;font-weight:900;letter-spacing:-.5px;
    background:linear-gradient(90deg,var(--text),var(--green));-webkit-background-clip:text;background-clip:text;color:transparent}
  .brand p{font-size:12px;color:var(--muted);margin-top:-4px}
  .h-actions{display:flex;gap:8px}
  .icon-btn{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:20px;
    background:var(--surface);border:1px solid var(--border);transition:transform .15s}
  .icon-btn:active{transform:scale(.9)}

  .alert{display:none;align-items:flex-start;gap:12px;padding:14px 16px;border-radius:var(--radius);margin-bottom:12px;cursor:pointer;
    background:linear-gradient(rgba(var(--red-rgb),.14),rgba(var(--red-rgb),.14)),var(--surface);
    border:1px solid rgba(var(--red-rgb),.55);box-shadow:0 0 calc(24px * var(--glow)) rgba(var(--red-rgb),.2);animation:slideDown .4s ease}
  .alert.show{display:flex}
  .alert .a-icon{font-size:24px;animation:pulse 1.6s infinite}
  .alert .a-body{flex:1}
  .alert strong{display:block;color:var(--red);font-size:16px}
  .alert span{font-size:14px;opacity:.9}
  .alert .a-close{width:40px;height:40px;border-radius:10px;font-size:18px;opacity:.7}
  .notice{display:none;gap:12px;padding:14px 16px;border-radius:var(--radius);margin-bottom:12px;
    background:linear-gradient(rgba(var(--yellow-rgb),.10),rgba(var(--yellow-rgb),.10)),var(--surface);
    border:1px solid rgba(var(--yellow-rgb),.45);animation:slideDown .4s ease}
  .notice.show{display:flex}
  .notice .n-icon{font-size:24px}
  .notice .n-body{flex:1}
  .notice strong{display:block;font-size:15px}
  .notice span{display:block;font-size:13px;color:var(--muted);margin-top:2px}
  .n-actions{display:flex;gap:8px;margin-top:10px}
  @keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}
  @keyframes slideDown{from{opacity:0;transform:translateY(-12px)}to{opacity:1;transform:none}}

  .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:4px 0 16px}
  .stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 8px;text-align:center;position:relative;overflow:hidden}
  .stat::before{content:"";position:absolute;inset:0 0 auto 0;height:3px;background:var(--c)}
  .stat .num{font-size:30px;font-weight:900;color:var(--c);line-height:1.2;text-shadow:0 0 calc(18px * var(--glow)) var(--c)}
  .stat .lbl-s{font-size:12px;color:var(--muted);font-weight:700}
  .stat.total{--c:var(--text)} .stat.total .num{text-shadow:none}
  .stat.soon{--c:var(--yellow)} .stat.expired{--c:var(--red)}

  .add-btn{width:100%;padding:22px;border-radius:22px;font-size:21px;font-weight:900;color:#04130d;
    background:linear-gradient(135deg,#00f0a0,#00d68f);box-shadow:0 10px 30px rgba(0,214,143,.35);
    display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:14px;transition:transform .15s}
  .add-btn:active{transform:scale(.97)}
  .add-btn .plus{width:36px;height:36px;border-radius:50%;background:rgba(0,0,0,.15);display:grid;place-items:center;font-size:26px;line-height:1}
  .strip-label{font-size:13px;font-weight:800;color:var(--muted);margin-bottom:8px}
  .quick-strip{display:flex;gap:8px;overflow-x:auto;margin-bottom:20px;padding-bottom:4px;scrollbar-width:none}
  .quick-strip::-webkit-scrollbar{display:none}
  .qchip{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:8px 14px;border-radius:14px;
    background:var(--surface);border:1px solid rgba(var(--green-rgb),.4);min-height:56px;text-align:right;transition:transform .12s}
  .qchip:active{transform:scale(.94);background:rgba(var(--green-rgb),.15)}
  .qchip b{font-size:14px;font-weight:800;white-space:nowrap}
  .qchip small{font-size:11px;color:var(--muted);white-space:nowrap}
  .qchip.ghost{border-style:dashed;border-color:var(--border);color:var(--muted);font-weight:700;font-size:13px}

  .search{position:relative;margin-bottom:12px}
  .search input{width:100%;padding:16px 50px 16px 16px;border-radius:16px;background:var(--surface);border:1px solid var(--border);font-size:16px;outline:none;transition:.2s}
  .search input:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(var(--green-rgb),.18)}
  .search .s-icon{position:absolute;right:18px;top:50%;transform:translateY(-50%);color:var(--muted);pointer-events:none}
  .search-hint{font-size:12px;color:var(--muted);margin:-6px 4px 10px;display:none}
  .filters{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:10px;scrollbar-width:none}
  .filters::-webkit-scrollbar{display:none}
  .filters.cats{margin-bottom:18px}
  .chip{--fc:var(--text);--fc-rgb:var(--text-rgb);flex-shrink:0;padding:10px 16px;border-radius:999px;background:var(--surface);border:1px solid var(--border);
    font-size:14px;font-weight:700;color:var(--muted);transition:.2s;min-height:44px}
  .chip .cnt{display:inline-block;min-width:22px;padding:0 6px;margin-right:6px;border-radius:999px;background:var(--surface-2);font-size:12px}
  .chip.active{color:var(--text);border-color:var(--fc);background:linear-gradient(rgba(var(--fc-rgb),.14),rgba(var(--fc-rgb),.14)),var(--surface)}
  .chip[data-f="fresh"]{--fc:var(--green);--fc-rgb:var(--green-rgb)}
  .chip[data-f="soon"]{--fc:var(--yellow);--fc-rgb:var(--yellow-rgb)}
  .chip[data-f="expired"]{--fc:var(--red);--fc-rgb:var(--red-rgb)}
  .cats .chip{padding:8px 14px;min-height:40px;font-size:13px}

  .section-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;gap:8px;flex-wrap:wrap}
  .section-title .lt{font-size:15px;font-weight:800}
  .section-title .lt small{display:block;font-size:11px;color:var(--muted);font-weight:400}
  .seg{display:flex;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:3px;gap:2px}
  .seg button{padding:6px 12px;border-radius:9px;font-size:13px;font-weight:700;color:var(--muted);min-height:36px}
  .seg button.active{background:var(--surface-2);color:var(--text);box-shadow:0 0 0 1px var(--border)}
  .seg.full{width:100%} .seg.full button{flex:1;min-height:44px}

  .list{display:flex;flex-direction:column;gap:12px}
  .group-h{font-size:13px;font-weight:800;color:var(--muted);margin:6px 4px -4px;display:flex;align-items:center;gap:6px}
  .group-h::after{content:"";flex:1;height:1px;background:var(--border)}
  .card{--c:var(--green);--c-rgb:var(--green-rgb);display:flex;gap:12px;align-items:stretch;padding:14px;border-radius:var(--radius);cursor:pointer;
    background:linear-gradient(135deg,rgba(var(--c-rgb),.10),rgba(var(--c-rgb),0) 60%),var(--surface);
    border:1px solid rgba(var(--c-rgb),.4);border-right:5px solid var(--c);
    box-shadow:0 0 calc(22px * var(--glow)) rgba(var(--c-rgb),.1);animation:fadeIn .3s ease;transition:transform .15s}
  .card:active{transform:scale(.985)}
  .card.soon{--c:var(--yellow);--c-rgb:var(--yellow-rgb)}
  .card.expired{--c:var(--red);--c-rgb:var(--red-rgb)}
  .card.flash{animation:flash 1.2s ease}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
  @keyframes flash{0%{box-shadow:0 0 0 0 rgba(var(--c-rgb),.6)}30%{box-shadow:0 0 0 6px rgba(var(--c-rgb),.4)}100%{box-shadow:none}}
  .thumb{width:60px;height:60px;border-radius:14px;flex-shrink:0;object-fit:cover;background:var(--surface-2);display:grid;place-items:center;font-size:26px;border:1px solid var(--border)}
  .c-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
  .c-name{font-size:18px;font-weight:800;word-break:break-word}
  .c-meta{display:flex;flex-wrap:wrap;gap:6px;font-size:13px;color:var(--muted)}
  .c-meta span{background:var(--surface-2);padding:2px 10px;border-radius:8px}
  .c-notes{font-size:13px;opacity:.8;word-break:break-word}
  .badge{align-self:flex-start;font-weight:900;font-size:15px;padding:4px 12px;border-radius:10px;
    color:var(--c);background:rgba(var(--c-rgb),.14);border:1px solid rgba(var(--c-rgb),.4)}
  .c-actions{display:flex;flex-direction:column;gap:8px;justify-content:center}
  .act-btn{width:46px;height:46px;border-radius:14px;display:grid;place-items:center;background:var(--surface-2);border:1px solid var(--border);font-size:19px;transition:.15s}
  .act-btn:active{transform:scale(.9)}
  .act-btn.del:active{border-color:var(--red)}
  .act-btn.prn:active{border-color:var(--green)}
  .empty{text-align:center;padding:40px 20px;color:var(--muted);border:2px dashed var(--border);border-radius:var(--radius)}
  .empty .e-icon{font-size:52px;margin-bottom:6px}
  .empty h3{color:var(--text);font-size:18px;margin-bottom:4px}
  .empty .btn{margin-top:16px;display:inline-block;flex:none;padding:14px 28px}

  .report{margin-top:28px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px}
  .report-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px;gap:8px}
  .report-head h3{font-size:17px;font-weight:900}
  .report-head small{display:block;font-size:12px;color:var(--muted);font-weight:400}
  .small-btn{padding:8px 14px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);font-size:13px;font-weight:700;min-height:40px}
  .small-btn.primary{background:#00d68f;border-color:#00d68f;color:#04130d}
  .legend{display:flex;gap:14px;font-size:12px;color:var(--muted);margin-bottom:4px}
  .legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-left:5px;vertical-align:middle}
  #chart{width:100%;height:190px;display:block}
  .report-sum{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
  .report-sum div{background:var(--surface-2);border-radius:12px;padding:10px 6px;text-align:center}
  .report-sum b{display:block;font-size:20px;font-weight:900}
  .report-sum span{font-size:11px;color:var(--muted);font-weight:700}
  .report-empty{font-size:13px;color:var(--muted);text-align:center;margin-top:6px}

  .app-footer{text-align:center;font-size:12px;color:var(--muted);padding:24px 16px 8px;margin-top:24px;border-top:1px solid var(--border);line-height:1.9}
  .app-footer b{color:var(--text);font-weight:800}
  .app-footer a{color:var(--green);text-decoration:none;font-weight:700}
  .app-footer a:active{opacity:.7}
  .app-footer .sep{opacity:.4;margin:0 6px}

  .fab{position:fixed;left:20px;bottom:calc(env(safe-area-inset-bottom,0px) + 20px);width:64px;height:64px;border-radius:50%;
    background:#00d68f;color:#04130d;font-size:34px;font-weight:900;box-shadow:0 8px 28px rgba(0,214,143,.5);
    display:grid;place-items:center;z-index:30;transform:scale(0);transition:transform .25s}
  .fab.show{transform:scale(1)}

  .overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);display:none;align-items:flex-end;justify-content:center;z-index:50}
  .overlay.open{display:flex;animation:fade .2s}
  @keyframes fade{from{opacity:0}to{opacity:1}}
  .sheet{width:100%;max-width:560px;max-height:92vh;overflow-y:auto;background:var(--surface);border:1px solid var(--border);
    border-radius:26px 26px 0 0;padding:10px 20px calc(env(safe-area-inset-bottom,0px) + 20px);animation:up .3s cubic-bezier(.2,.9,.3,1)}
  @keyframes up{from{transform:translateY(100%)}to{transform:none}}
  @media (min-width:640px){.overlay{align-items:center}.sheet{border-radius:26px}}
  .grab{width:44px;height:5px;border-radius:5px;background:var(--border);margin:4px auto 14px}
  .sheet h2{font-size:21px;font-weight:900;margin-bottom:14px}
  .field{margin-bottom:14px}
  .field > label,.flabel{display:block;font-size:14px;font-weight:700;margin-bottom:6px}
  .field label small,.flabel small{color:var(--muted);font-weight:400}
  .field input,.field textarea{width:100%;padding:14px 14px;border-radius:14px;background:var(--bg);border:1px solid var(--border);font-size:16px;outline:none;transition:.2s}
  .field input:focus,.field textarea:focus{border-color:var(--green);box-shadow:0 0 0 3px rgba(var(--green-rgb),.18)}
  [data-theme="dark"] .field input[type="date"]{color-scheme:dark}
  .field input[type="date"]{min-height:52px}
  .field textarea{resize:vertical;min-height:70px}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .row2 label{font-size:13px;font-weight:700;display:block;margin-bottom:4px}
  .quick{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
  .quick button{padding:8px 14px;border-radius:10px;background:var(--surface-2);border:1px solid var(--border);font-size:13px;font-weight:700;min-height:40px}
  .quick button.sel{border-color:var(--green);color:var(--green);background:rgba(var(--green-rgb),.12)}
  .hint{font-size:13px;color:var(--green);margin-top:8px;font-weight:700}
  .hint.bad{color:var(--red)}
  .sug{display:none;margin-top:6px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;overflow:hidden}
  .sug.show{display:block}
  .sug button{display:flex;justify-content:space-between;align-items:center;gap:8px;width:100%;padding:10px 14px;border-bottom:1px solid var(--border);font-size:15px;font-weight:700;text-align:right;min-height:48px}
  .sug button:last-child{border-bottom:none}
  .sug small{color:var(--muted);font-weight:400;font-size:12px;white-space:nowrap}
  .toggle{display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;background:var(--surface-2);border:1px solid var(--border);width:100%;font-size:14px;font-weight:700;min-height:52px;text-align:right}
  .toggle .box{width:24px;height:24px;border-radius:7px;border:2px solid var(--muted);display:grid;place-items:center;font-size:14px;flex-shrink:0}
  .toggle.on{border-color:var(--green)}
  .toggle.on .box{background:var(--green);border-color:var(--green);color:#04130d}
  .photo-pick{display:flex;align-items:center;gap:12px;padding:10px;border-radius:14px;border:1px dashed var(--border);background:var(--bg);cursor:pointer}
  .photo-pick img{width:52px;height:52px;border-radius:12px;object-fit:cover;display:none}
  .photo-pick .ph{width:52px;height:52px;border-radius:12px;display:grid;place-items:center;background:var(--surface-2);font-size:22px}
  .photo-pick .pt{flex:1;font-size:14px;color:var(--muted)}
  .photo-pick .pr{font-size:13px;color:var(--red);padding:8px;display:none}
  .err{color:var(--red);font-size:13px;margin-top:4px;display:none}
  .actions{display:flex;gap:10px;margin-top:18px}
  .actions.col{flex-direction:column}
  .btn{flex:1;padding:15px;border-radius:14px;font-size:17px;font-weight:800;min-height:54px;transition:transform .15s}
  .btn:active{transform:scale(.97)}
  .btn.primary{background:#00d68f;color:#04130d}
  .btn.ghost{background:var(--surface-2);border:1px solid var(--border)}
  .btn.red{background:var(--red);color:#fff}
  .btn.suggested{outline:3px solid var(--text);outline-offset:2px}
  .link-btn{color:var(--muted);font-size:13px;text-decoration:underline;padding:10px;margin-top:4px;align-self:center}
  .sub{color:var(--muted);font-size:14px;margin:-8px 0 8px}
  .confirm-icon{font-size:48px;text-align:center;margin-bottom:6px}
  .confirm-text-block{white-space:pre-line;font-size:14px;line-height:1.9;color:var(--muted);text-align:center;margin:0}
  .storage-status{font-size:13px;padding:10px 12px;border-radius:12px;background:var(--surface-2);margin-bottom:10px;color:var(--muted)}
  .menu-list{display:flex;flex-direction:column;gap:8px}
  .menu-item{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;background:var(--surface-2);border:1px solid var(--border);font-size:16px;font-weight:700;text-align:right;min-height:56px}
  .menu-item > span{font-size:22px}
  .menu-item small{display:block;font-size:12px;color:var(--muted);font-weight:400}
  .menu-item.danger{color:var(--red)}
  .menu-item.hl{border-color:var(--green)}

  .tpl-form{background:var(--surface-2);border:1px solid var(--border);border-radius:16px;padding:14px;margin-bottom:14px}
  .tpl-form .field{margin-bottom:10px}
  .tpl-list{display:flex;flex-direction:column;gap:8px}
  .tpl-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:14px;background:var(--surface-2);border:1px solid var(--border)}
  .tpl-row .tn{flex:1;min-width:0;font-weight:800}
  .tpl-row .tn small{display:block;color:var(--muted);font-size:12px;font-weight:400}
  .tpl-row button{width:44px;height:44px;border-radius:12px;background:var(--surface);border:1px solid var(--border);font-size:17px}
  .tpl-empty{text-align:center;color:var(--muted);font-size:14px;padding:16px}

  .preview-wrap{display:flex;justify-content:center;align-items:center;padding:18px;background:#d9dae0;border-radius:14px;margin-bottom:14px;overflow:auto;min-height:150px}
  .stepper{display:flex;align-items:center;gap:12px}
  .stepper button{width:48px;height:48px;border-radius:12px;background:var(--surface-2);border:1px solid var(--border);font-size:22px;font-weight:900}
  .stepper output{min-width:44px;text-align:center;font-size:22px;font-weight:900}
  .print-note{font-size:12px;color:var(--muted);margin-top:10px}

  .lbl{--f:1;box-sizing:border-box;color:#000;background:#fff;font-family:var(--font);direction:rtl;text-align:right;line-height:1.25;
    display:flex;flex-direction:column;gap:.8mm;overflow:hidden;padding:1.6mm 2.2mm;border:.3mm solid #000;border-radius:1.5mm;
