  function buildHistory(){
    if(historyCache) return historyCache;
    var map = {}, order = [];
    function put(o){
      var k = norm(o.name); if(!k) return;
      var ex = map[k];
      if(!ex){ map[k] = o; order.push(k); return; }
      if(ex.days == null && o.days != null) ex.days = o.days;
      if(!ex.cat && o.cat) ex.cat = o.cat;
      if(!ex.qty && o.qty) ex.qty = o.qty;
      if(!ex.photo && o.photo) ex.photo = o.photo;
    }
    sortedTemplates().forEach(function(t){ put({name:t.name, days:t.days, cat:t.cat, qty:t.qty || '', photo:null, tpl:true}); });
    items.slice().sort(function(a,b){ return (b.created||0) - (a.created||0); })
      .forEach(function(it){ put({name:it.name, days:itemDuration(it), cat:it.cat || '', qty:it.qty || '', photo:it.photo || null}); });
    log.slice().reverse().forEach(function(l){ put({name:l.name, days:(typeof l.days === 'number' ? l.days : null), cat:l.cat || '', qty:l.qty || ''}); });
    historyCache = order.map(function(k){ return map[k]; });
    return historyCache;
  }
