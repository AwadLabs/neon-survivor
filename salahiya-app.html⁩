    items.splice(idx, 1);
    save(); render(); checkAlert(); updateNotice(); buzz(15);
    var msg = outcome === 'wasted' ? '🗑️ سُجّل "' + it.name + '" كتالف'
            : outcome === 'used' ? '✅ سُجّل "' + it.name + '" كمستخدم'
            : '🗑️ تم حذف "' + it.name + '"';
    showToast(msg, function(){
