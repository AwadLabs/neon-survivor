  /* ---------- Snapshot (safe clear & restore) ---------- */
  function readSnap(){
    var s = readJSON(SNAP_KEY, null);
    return (s && typeof s === 'object' && (Array.isArray(s.items) || Array.isArray(s.log))) ? s : null;
  }
  function clearWithSnapshot(kind){
    invalidateHistory();
    var prevItems = items, prevLog = log;
    var snap = {at:Date.now(), kind:kind, items: kind === 'items' ? prevItems : [], log: kind === 'log' ? prevLog : []};
    if(kind === 'items') items = []; else log = [];
    try{
      localStorage.setItem(KEY, JSON.stringify(items));
      localStorage.setItem(LOG_KEY, JSON.stringify(log));
      try{ localStorage.setItem(SNAP_KEY, JSON.stringify(snap)); }
      catch(e1){
        console.error('[salahiya] snapshot with photos failed, retrying without:', e1);
        snap.items = snap.items.map(function(x){ return Object.assign({}, x, {photo:null}); });
        snap.noPhotos = true;
        localStorage.setItem(SNAP_KEY, JSON.stringify(snap));
      }
      return snap;
    }catch(e){
      console.error('[salahiya] clear failed, rolling back:', e);
      items = prevItems; log = prevLog;
      try{ localStorage.setItem(KEY, JSON.stringify(items)); localStorage.setItem(LOG_KEY, JSON.stringify(log)); }catch(e2){ console.error(e2); }
      return null;
    }
  }
  function restoreSnapshot(){
    var snap = readSnap();
    if(!snap){ showToast('لا توجد نسخة للاستعادة'); return; }
    var prevItems = items.slice(), prevLog = log.slice();
    var ids = {}; items.forEach(function(x){ ids[x.id] = true; });
    var addedItems = 0;
    (snap.items || []).forEach(function(x){ if(x && x.id && !ids[x.id]){ items.push(x); addedItems++; } });
    var lids = {}; log.forEach(function(l){ lids[l.id] = true; });
    var addedLog = 0;
    (snap.log || []).forEach(function(l){ if(l && l.id && !lids[l.id]){ log.push(l); addedLog++; } });
    if(!save()){ items = prevItems; log = prevLog; invalidateHistory(); return; }
    try{ localStorage.removeItem(SNAP_KEY); }catch(e){ console.error(e); }
    render(); checkAlert(); updateNotice();
    showToast(snap.kind === 'log' ? '♻️ تمت استعادة ' + addedLog + ' سجل' : '♻️ تمت استعادة ' + addedItems + ' منتج' + (snap.noPhotos ? ' (بدون الصور)' : ''));
  }

