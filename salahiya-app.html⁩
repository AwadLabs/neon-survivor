<script>
(function(){
  'use strict';
  var KEY = 'salahiya_items_v1', LOG_KEY = 'salahiya_log_v1', THEME_KEY = 'salahiya_theme',
      META_KEY = 'salahiya_meta', SNAP_KEY = 'salahiya_snapshot', TPL_KEY = 'salahiya_templates_v1';
  var DAY = 86400000;
  var PHOTO_MAX = 200, PHOTO_QUALITY = 0.45;
  var CATS = [
    {id:'chilled', label:'مبرد', icon:'🧊'},
    {id:'frozen',  label:'مجمد', icon:'❄️'},
    {id:'dry',     label:'جاف',  icon:'🌾'},
    {id:'canned',  label:'معلب', icon:'🥫'}
  ];
  var STATUS_ICON = {fresh:'✓', soon:'⏳', expired:'⛔'};
  var WEEK_NAMES = {0:'الأحد', 6:'السبت'};
  var WD = ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];

  var items = [], log = [], templates = [], meta = {};
  var filter = 'all', catFilter = 'all', query = '';
  var editingId = null, pendingPhoto = null, formCat = '', saveAsTpl = false, sugList = [];
  var tplEditId = null, tplCat = '';
  var printId = null, printCopies = 1;
  var deleteId = null, flashId = null, undoAction = null, toastActFn = null;
  var toastTimer = null, confirmAction = null, noticeKind = null, persisted = null;
  var historyCache = null;
  var $ = function(id){ return document.getElementById(id); };

  /* ---------- Storage ---------- */
  function readJSON(k, fallback){
    try{ var v = JSON.parse(localStorage.getItem(k)); return v == null ? fallback : v; }
    catch(e){ console.error('[salahiya] read failed:', k, e); return fallback; }
  }
  function load(){
    items = readJSON(KEY, []); if(!Array.isArray(items)) items = [];
    log = readJSON(LOG_KEY, []); if(!Array.isArray(log)) log = [];
    templates = readJSON(TPL_KEY, []); if(!Array.isArray(templates)) templates = [];
    invalidateHistory();
  }
  function invalidateHistory(){ historyCache = null; }
  function save(){
    invalidateHistory();
    try{
      localStorage.setItem(KEY, JSON.stringify(items));
      localStorage.setItem(LOG_KEY, JSON.stringify(log));
      localStorage.setItem(TPL_KEY, JSON.stringify(templates));
      return true;
    }catch(e){
      console.error('[salahiya] save failed:', e);
      showToast('⚠️ الذاكرة ممتلئة، صدّر نسخة احتياطية واحذف بعض الصور');
      return false;
    }
  }
  function loadMeta(){
    meta = readJSON(META_KEY, {});
    if(!meta || typeof meta !== 'object' || Array.isArray(meta)) meta = {};
    if(!meta.firstUse) meta.firstUse = Date.now();
    if(meta.weekStart !== 0 && meta.weekStart !== 6) meta.weekStart = 0;
    if(['expiry','alpha','cat'].indexOf(meta.sort) === -1) meta.sort = 'expiry';
    if(['s','m','a4'].indexOf(meta.printSize) === -1) meta.printSize = 's';
    if(typeof meta.printBy !== 'string') meta.printBy = '';
    saveMeta();
  }
  function saveMeta(){
    try{ localStorage.setItem(META_KEY, JSON.stringify(meta)); }
    catch(e){ console.error('[salahiya] meta save failed:', e); }
  }
  function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

  function requestPersist(){
    try{
      if(!navigator.storage || !navigator.storage.persisted) return;
      navigator.storage.persisted().then(function(p){
        if(p) return true;
        if(navigator.storage.persist) return navigator.storage.persist();
        return false;
      }).then(function(granted){
        persisted = !!granted;
        updateStorageStatus();
      }).catch(function(e){ console.error('[salahiya] persist failed:', e); });
    }catch(e){ console.error('[salahiya] persist unavailable:', e); }
  }
  function isStandalone(){
    try{ return (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone === true; }
    catch(e){ return false; }
  }
  function isIOS(){
    return /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  }

  /* ---------- Dates ---------- */
  function todayMidnight(){ var d = new Date(); d.setHours(0,0,0,0); return d; }
  function todayISO(){ return toISO(todayMidnight()); }
  function toISO(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function parseISO(s){ var p = s.split('-'); return new Date(+p[0], +p[1]-1, +p[2]); }
  function addDays(iso, n){ var d = parseISO(iso); d.setDate(d.getDate() + n); return toISO(d); }
  function diffDays(a, b){ return Math.round((parseISO(b) - parseISO(a)) / DAY); }
  function daysLeft(iso){ return Math.round((parseISO(iso) - todayMidnight()) / DAY); }
  function status(d){ return d <= 0 ? 'expired' : (d <= 3 ? 'soon' : 'fresh'); }
  function daysWord(n){
    if(n === 1) return 'يوم واحد';
    if(n === 2) return 'يومان';
    if(n <= 10) return n + ' أيام';
    return n + ' يوماً';
  }
  function daysShort(n){ return n === 0 ? 'نفس اليوم' : daysWord(n); }
  function remainingText(d){
    if(d < 0) return 'انتهى منذ ' + daysWord(-d);
    if(d === 0) return 'ينتهي اليوم';
    return 'باقي ' + daysWord(d);
  }
  function ago(ts){ var n = Math.floor((Date.now() - ts) / DAY); return n <= 0 ? 'اليوم' : 'منذ ' + daysWord(n); }
  function formatDate(iso){
    try{ return parseISO(iso).toLocaleDateString('ar', {weekday:'short', day:'numeric', month:'short'}); }
    catch(e){ return iso; }
  }
  function wd(iso){ return WD[parseISO(iso).getDay()]; }
  function dm(iso){ var d = parseISO(iso); return d.getDate() + '/' + (d.getMonth()+1); }
  function dmy(iso){ var d = parseISO(iso); return d.getDate() + '/' + (d.getMonth()+1) + '/' + d.getFullYear(); }
  function hm(ts){
    var d = new Date(ts), h = d.getHours(), m = String(d.getMinutes()).padStart(2,'0');
    var ap = h < 12 ? 'ص' : 'م'; h = h % 12 || 12;
    return h + ':' + m + ' ' + ap;
  }
  function weekStart(d){
    var x = new Date(d); x.setHours(0,0,0,0);
    x.setDate(x.getDate() - ((x.getDay() - meta.weekStart + 7) % 7));
    return x;
  }
  function prepOf(it){ return it.prep || (it.created ? toISO(new Date(it.created)) : null); }
  function itemDuration(it){
    var p = prepOf(it); if(!p) return null;
    var n = diffDays(p, it.date);
    return n >= 0 ? n : null;
  }
  function catOf(id){ for(var i=0;i<CATS.length;i++) if(CATS[i].id === id) return CATS[i]; return null; }
  function catIndex(id){ for(var i=0;i<CATS.length;i++) if(CATS[i].id === id) return i; return 99; }

  function esc(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  /* ---------- Fuzzy Arabic search ---------- */
  function norm(s){
    return String(s).toLowerCase()
      .replace(/[\u064B-\u0652\u0640]/g,'')
      .replace(/[أإآٱ]/g,'ا').replace(/ة/g,'ه').replace(/ى/g,'ي')
      .replace(/ؤ/g,'و').replace(/ئ/g,'ي').replace(/\s+/g,' ').trim();
  }
  function words(s){
    return s.split(' ').filter(Boolean).map(function(w){ return (w.indexOf('ال') === 0 && w.length > 3) ? w.slice(2) : w; });
  }
  function lev(a, b){
    if(a === b) return 0;
    var m = a.length, n = b.length, prev = [], cur, i, j;
    for(j=0;j<=n;j++) prev[j] = j;
    for(i=1;i<=m;i++){
      cur = [i];
      for(j=1;j<=n;j++) cur[j] = Math.min(prev[j]+1, cur[j-1]+1, prev[j-1] + (a[i-1] === b[j-1] ? 0 : 1));
      prev = cur;
    }
    return prev[n];
  }
  function matchScore(name, q){
    var n = norm(name), qq = norm(q);
    if(!qq) return 2;
    if(n.indexOf(qq) > -1) return 2;
    var nw = words(n);
    var ok = words(qq).every(function(w){
      return nw.some(function(x){
        if(x.indexOf(w) > -1 || (x.length >= 3 && w.indexOf(x) > -1)) return true;
        var t = w.length >= 5 ? 2 : (w.length >= 3 ? 1 : 0);
        return t > 0 && lev(w, x) <= t;
      });
    });
    return ok ? 1 : 0;
  }
  var collator = (window.Intl && Intl.Collator) ? new Intl.Collator('ar') : null;
  function cmpName(a, b){ return collator ? collator.compare(a, b) : a.localeCompare(b); }

  /* ---------- Templates ---------- */
  function sortedTemplates(){
    return templates.slice().sort(function(a,b){ return ((b.uses||0) - (a.uses||0)) || cmpName(a.name, b.name); });
  }
  function findTplByName(name){
    var k = norm(name);
    for(var i=0;i<templates.length;i++) if(norm(templates[i].name) === k) return templates[i];
    return null;
  }
  function upsertTemplate(t){
    var ex = findTplByName(t.name);
    if(ex){ ex.name = t.name; ex.days = t.days; ex.cat = t.cat || ''; ex.qty = t.qty || ''; return ex; }
    var n = {id:uid(), name:t.name, days:t.days, cat:t.cat || '', qty:t.qty || '', uses:0, created:Date.now()};
    templates.push(n);
    return n;
  }
  function renderQuick(){
    var html = sortedTemplates().map(function(t){
      var c = catOf(t.cat);
      return '<button class="qchip" data-t="' + esc(t.id) + '"><b>' + (c ? c.icon + ' ' : '') + esc(t.name) + '</b><small>صلاحية ' + daysShort(t.days) + '</small></button>';
    }).join('');
    html += templates.length
      ? '<button class="qchip ghost" data-t="_manage">⚙️ إدارة</button>'
      : '<button class="qchip ghost" data-t="_manage">➕ أنشئ قالبك الأول (مثال: صوص الثوم · 3 أيام)</button>';
    $('quickStrip').innerHTML = html;
  }
  function historyPhoto(name){
    var k = norm(name), best = null;
    items.forEach(function(it){ if(it.photo && norm(it.name) === k && (!best || (it.created||0) > (best.created||0))) best = it; });
    return best ? best.photo : null;
  }
  function quickAdd(tplId){
    var t = templates.find(function(x){ return x.id === tplId; });
    if(!t) return;
    var prep = todayISO();
    var it = {id:uid(), name:t.name, prep:prep, date:addDays(prep, t.days), qty:t.qty || '', notes:'',
              photo:historyPhoto(t.name), cat:t.cat || '', created:Date.now(), fromTpl:t.id};
    items.push(it);
    t.uses = (t.uses || 0) + 1; t.lastUsed = Date.now();
    if(!save()){ items.pop(); t.uses--; return; }
    buzz(20);
    flashId = it.id;
    if(items.length === 1) requestPersist();
    render(); renderQuick(); checkAlert(); updateNotice();
    showToast('⚡ ' + t.name + ' — ينتهي ' + wd(it.date), function(){
      items = items.filter(function(x){ return x.id !== it.id; });
      t.uses = Math.max(0, (t.uses||1) - 1);
      save(); render(); renderQuick(); checkAlert(); updateNotice();
    }, {label:'🖨️ طباعة', fn:function(){ openPrint(it.id); }});
  }

