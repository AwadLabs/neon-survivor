  function handlePhoto(file){
    if(!file) return;
    $('phText').textContent = 'جاري المعالجة...';
    var reader = new FileReader();
    reader.onload = function(){
      var img = new Image();
      img.onload = function(){
        var w = img.width, h = img.height;
        if(w > h && w > PHOTO_MAX){ h = h*PHOTO_MAX/w; w = PHOTO_MAX; }
        else if(h > PHOTO_MAX){ w = w*PHOTO_MAX/h; h = PHOTO_MAX; }
        var c = document.createElement('canvas');
        c.width = Math.round(w); c.height = Math.round(h);
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        setPhoto(c.toDataURL('image/jpeg', PHOTO_QUALITY));
      };
      img.onerror = function(e){ console.error('[salahiya] image decode failed:', e); setPhoto(null); showToast('تعذر قراءة الصورة'); };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
  }

  /* ---------- Export / Import ---------- */
  function markBackup(){ meta.lastBackup = Date.now(); meta.backupSnooze = 0; saveMeta(); updateNotice(); }
  function exportData(){
    var payload = JSON.stringify({app:'salahiya', version:4, exported:new Date().toISOString(), items:items, log:log, templates:templates,
      settings:{weekStart:meta.weekStart, printSize:meta.printSize}});
    var name = 'salahiya-backup-' + toISO(new Date()) + '.json';
    var blob = new Blob([payload], {type:'application/json'});
    function download(){
      var url = URL.createObjectURL(blob), a = document.createElement('a');
      a.href = url; a.download = name; document.body.appendChild(a); a.click();
      setTimeout(function(){ URL.revokeObjectURL(url); a.remove(); }, 1500);
      markBackup(); showToast('✅ تم حفظ ' + name);
    }
    try{
      var file = new File([blob], name, {type:'application/json'});
      if(navigator.canShare && navigator.canShare({files:[file]})){
        navigator.share({files:[file], title:'نسخة احتياطية - صلاحية'})
          .then(function(){ markBackup(); showToast('✅ تم تصدير النسخة الاحتياطية'); })
          .catch(function(err){ if(!err || err.name !== 'AbortError'){ console.error('[salahiya] share failed:', err); download(); } });
        return;
      }
    }catch(e){ console.error('[salahiya] share unavailable:', e); }
    download();
  }
  function importData(file){
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(){
      try{
        var data = JSON.parse(reader.result);
        var inItems = Array.isArray(data) ? data : data.items;
        if(!Array.isArray(inItems)) throw new Error('bad format');
        var isoRe = /^\d{4}-\d{2}-\d{2}$/;
        var valid = inItems.filter(function(x){ return x && typeof x.name === 'string' && isoRe.test(x.date); }).map(function(x){
          return {id: x.id || uid(), name: x.name.slice(0,60), date: x.date, prep: isoRe.test(x.prep) ? x.prep : undefined,
                  qty: x.qty || '', notes: x.notes || '',
                  photo: (typeof x.photo === 'string' && x.photo.indexOf('data:image/') === 0) ? x.photo : null,
                  cat: catOf(x.cat) ? x.cat : '', created: x.created || Date.now()};
        });
        var inLog = Array.isArray(data.log) ? data.log.filter(function(l){ return l && l.name && l.at && l.outcome; }) : [];
        var inTpl = Array.isArray(data.templates) ? data.templates.filter(function(t){
          return t && typeof t.name === 'string' && typeof t.days === 'number' && t.days >= 0 && t.days <= 365;
        }) : [];
        askConfirm({icon:'📥', title:'استيراد النسخة؟',
          text:'سيتم دمج ' + valid.length + ' منتج و' + inLog.length + ' سجل و' + inTpl.length + ' قالب مع بياناتك الحالية.', yes:'استيراد', info:true}, function(){
          var bI = items.slice(), bL = log.slice(), bT = JSON.parse(JSON.stringify(templates));
          var map = {}; items.forEach(function(x){ map[x.id] = x; });
          valid.forEach(function(x){ map[x.id] = x; });
          items = Object.keys(map).map(function(k){ return map[k]; });
          var lmap = {}; log.forEach(function(l){ lmap[l.id] = l; });
          inLog.forEach(function(l){ l.id = l.id || uid(); lmap[l.id] = l; });
          log = Object.keys(lmap).map(function(k){ return lmap[k]; });
          inTpl.forEach(function(t){
            var ex = findTplByName(t.name);
            if(ex){ ex.days = t.days; if(catOf(t.cat)) ex.cat = t.cat; if(t.qty) ex.qty = t.qty; }
            else templates.push({id:t.id || uid(), name:t.name.slice(0,60), days:t.days, cat:catOf(t.cat) ? t.cat : '', qty:t.qty || '', uses:t.uses || 0, created:t.created || Date.now()});
          });
          if(!save()){ items = bI; log = bL; templates = bT; invalidateHistory(); return; }
          render(); renderQuick(); checkAlert(); updateNotice();
          showToast('✅ تم استيراد ' + valid.length + ' منتج و' + inTpl.length + ' قالب');
        });
      }catch(e){ console.error('[salahiya] import failed:', e); showToast('⚠️ الملف غير صالح'); }
    };
    reader.readAsText(file);
  }

  /* ---------- Menu ---------- */
  function updateStorageStatus(){
    var st = $('storageStatus');
    if(isStandalone() || persisted === true){
      st.textContent = '🔒 التخزين محمي على هذا الجهاز' + (meta.lastBackup ? ' · آخر نسخة ' + ago(meta.lastBackup) : '');
    } else if(persisted === null){
      st.textContent = '⏳ جارٍ التحقق من حماية التخزين...';
    } else {
      st.textContent = '⚠️ قد يحذف المتصفح بياناتك إذا لم تفتح التطبيق لفترة. ثبّته على الشاشة الرئيسية وصدّر نسخاً دورية.';
    }
  }
  function openMenu(){
    updateStorageStatus();
    $('mTplSub').textContent = templates.length ? templates.length + ' قالب' : 'أضف ما تحضّره يومياً';
    $('mExportSub').textContent = meta.lastBackup ? 'آخر نسخة: ' + ago(meta.lastBackup) : 'لم تحفظ أي نسخة بعد';
    $('mExport').classList.toggle('hl', !meta.lastBackup || Date.now() - meta.lastBackup > 7*DAY);
    $('mInstall').style.display = isStandalone() ? 'none' : 'flex';
    $('mWeekSub').textContent = 'حالياً: ' + WEEK_NAMES[meta.weekStart] + ' — اضغط للتبديل';
    updateSoundLabel();
    var snap = readSnap();
    if(snap){
      var n = snap.kind === 'log' ? (snap.log || []).length + ' سجل' : (snap.items || []).length + ' منتج';
      $('mRestoreSub').textContent = 'مُسح ' + ago(snap.at) + ' — ' + n;
      $('mRestore').style.display = 'flex';
    } else $('mRestore').style.display = 'none';
    openModal('menuModal');
  }

  /* ---------- Theme ---------- */
  function applyTheme(t){
    document.documentElement.setAttribute('data-theme', t);
    $('themeBtn').textContent = t === 'dark' ? '☀️' : '🌙';
    $('metaTheme').setAttribute('content', t === 'dark' ? '#0a0a0f' : '#f3f4f8');
    try{ localStorage.setItem(THEME_KEY, t); }catch(e){ console.error(e); }
  }
  function toggleTheme(){
    applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    renderReport();
  }

  /* ---------- Toast ---------- */
  function showToast(text, undoFn, act){
    undoAction = typeof undoFn === 'function' ? undoFn : null;
    toastActFn = act && typeof act.fn === 'function' ? act.fn : null;
    $('toastText').textContent = text;
    $('toastUndo').style.display = undoAction ? 'inline-block' : 'none';
    $('toastAct').style.display = toastActFn ? 'inline-block' : 'none';
    $('toastAct').textContent = toastActFn ? act.label : '';
    $('toast').classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ $('toast').classList.remove('show'); undoAction = null; toastActFn = null; },
      (undoAction || toastActFn) ? 6000 : 2600);
  }
  function hideToast(){ $('toast').classList.remove('show'); clearTimeout(toastTimer); }

  /* ---------- Events ---------- */
  $('addBtn').addEventListener('click', function(){ openForm(null); });
  $('fab').addEventListener('click', function(){ openForm(null); });
  $('cancelAdd').addEventListener('click', function(){ closeModal('addModal'); });
  $('saveAdd').addEventListener('click', saveItem);
  $('printFromForm').addEventListener('click', function(){
    var id = editingId; if(!id) return;
    closeModal('addModal'); openPrint(id);
  });
  $('fName').addEventListener('input', function(){ renderSug(); updateTplToggle(); $('errName').style.display = 'none'; });
  $('fName').addEventListener('focus', renderSug);
  $('fName').addEventListener('blur', function(){ setTimeout(hideSug, 180); });
  $('fName').addEventListener('keydown', function(e){ if(e.key === 'Enter'){ e.preventDefault(); hideSug(); $('fQty').focus(); } });
  $('sugBox').addEventListener('pointerdown', function(e){
    var b = e.target.closest('button'); if(!b) return;
    e.preventDefault(); applySug(+b.dataset.i);
  });
  $('fPrep').addEventListener('change', updateDurHint);
  $('fDate').addEventListener('change', function(){ $('errDate').style.display = 'none'; updateDurHint(); });

  $('quickDates').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    if(!$('fPrep').value) $('fPrep').value = todayISO();
    $('fDate').value = addDays($('fPrep').value, +b.dataset.d);
    $('errDate').style.display = 'none'; updateDurHint(); buzz(8);
  });
  $('quickQty').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return; $('fQty').value = b.textContent; buzz(8);
  });
  $('formCats').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    formCat = formCat === b.dataset.c ? '' : b.dataset.c; renderFormCats(); buzz(8);
  });
  $('tplToggle').addEventListener('click', function(){ saveAsTpl = !saveAsTpl; updateTplToggle(); buzz(8); });

  $('fPhoto').addEventListener('change', function(){ handlePhoto(this.files && this.files[0]); });
  $('phRemove').addEventListener('click', function(e){ e.preventDefault(); e.stopPropagation(); setPhoto(null); });

  $('quickStrip').addEventListener('click', function(e){
    var b = e.target.closest('.qchip'); if(!b) return;
    if(b.dataset.t === '_manage') openTplManager(); else quickAdd(b.dataset.t);
  });

  $('tQuickDays').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return; $('tDays').value = b.dataset.d; buzz(8);
  });
  $('tCats').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    tplCat = tplCat === b.dataset.c ? '' : b.dataset.c; renderTplCats();
  });
  $('tSave').addEventListener('click', saveTplForm);
  $('tCancelEdit').addEventListener('click', resetTplForm);
  $('tplClose').addEventListener('click', function(){ closeModal('tplModal'); });
  $('tplList').addEventListener('click', function(e){
    var ed = e.target.closest('[data-edit]'), rm = e.target.closest('[data-rm]');
    if(ed){
      var t = templates.find(function(x){ return x.id === ed.dataset.edit; }); if(!t) return;
      tplEditId = t.id; tplCat = t.cat || '';
      $('tName').value = t.name; $('tDays').value = t.days; $('tQty').value = t.qty || '';
      $('tFormTitle').textContent = 'تعديل قالب';
      $('tSave').textContent = '💾 حفظ التعديل';
      $('tCancelEdit').style.display = '';
      $('tErr').style.display = 'none';
      renderTplCats();
      $('tName').focus();
    } else if(rm){
      var idx = templates.findIndex(function(x){ return x.id === rm.dataset.rm; }); if(idx === -1) return;
      var removed = templates.splice(idx, 1)[0];
      save(); renderTplList(); renderQuick();
      if(tplEditId === removed.id) resetTplForm();
      showToast('🗑️ حُذف قالب "' + removed.name + '"', function(){
        templates.splice(Math.min(idx, templates.length), 0, removed);
        save(); renderTplList(); renderQuick();
      });
    }
  });

  $('list').addEventListener('click', function(e){
    if(e.target.closest('[data-act="add"]')){ openForm(null); return; }
    var del = e.target.closest('[data-del]');
    if(del){ e.stopPropagation(); askDelete(del.dataset.del); return; }
    var prn = e.target.closest('[data-prn]');
    if(prn){ e.stopPropagation(); openPrint(prn.dataset.prn); return; }
    var card = e.target.closest('.card');
    if(card){ var it = items.find(function(x){ return x.id === card.dataset.id; }); if(it) openForm(it); }
  });

  $('sizeSeg').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    meta.printSize = b.dataset.z; saveMeta(); renderPrint(); buzz(8);
  });
  $('cpMinus').addEventListener('click', function(){ printCopies = Math.max(1, printCopies - 1); $('cpOut').textContent = printCopies; });
  $('cpPlus').addEventListener('click', function(){ printCopies = Math.min(21, printCopies + 1); $('cpOut').textContent = printCopies; });
  $('pBy').addEventListener('input', renderPrint);
  $('pCancel').addEventListener('click', function(){ closeModal('printModal'); });
  $('pGo').addEventListener('click', doPrint);

  $('delUsed').addEventListener('click', function(){ doDelete('used'); });
  $('delWasted').addEventListener('click', function(){ doDelete('wasted'); });
  $('delSilent').addEventListener('click', function(){ doDelete(null); });
  $('delCancel').addEventListener('click', function(){ closeModal('deleteModal'); });

  $('toastUndo').addEventListener('click', function(){
    var fn = undoAction; undoAction = null; toastActFn = null; hideToast(); if(fn) fn();
  });
  $('toastAct').addEventListener('click', function(){
    var fn = toastActFn; toastActFn = null; undoAction = null; hideToast(); if(fn) fn();
  });

  $('cfNo').addEventListener('click', function(){ closeModal('confirmModal'); confirmAction = null; });
  $('cfYes').addEventListener('click', function(){
    closeModal('confirmModal'); var fn = confirmAction; confirmAction = null; if(fn) fn();
  });

  $('nYes').addEventListener('click', function(){
    if(noticeKind === 'backup'){ exportData(); return; }
    meta.installSnooze = Date.now() + 30*DAY; saveMeta();
    if(items.length) exportData();
    updateNotice();
  });
  $('nNo').addEventListener('click', function(){
    if(noticeKind === 'backup') meta.backupSnooze = Date.now() + DAY;
    else meta.installSnooze = Date.now() + 3*DAY;
    saveMeta(); updateNotice();
  });

  $('menuBtn').addEventListener('click', openMenu);
  $('menuClose').addEventListener('click', function(){ closeModal('menuModal'); });
  $('mRestore').addEventListener('click', function(){ closeModal('menuModal'); restoreSnapshot(); });
  $('mTpl').addEventListener('click', function(){ closeModal('menuModal'); openTplManager(); });
  $('mExport').addEventListener('click', function(){ closeModal('menuModal'); exportData(); });
  $('mImport').addEventListener('click', function(){ closeModal('menuModal'); $('importInput').click(); });
  $('importInput').addEventListener('change', function(){ importData(this.files && this.files[0]); this.value = ''; });
  $('mInstall').addEventListener('click', function(){
    closeModal('menuModal');
    askConfirm({icon:'📲', title:'التثبيت على الشاشة الرئيسية', text:installText(), yes:'فهمت', info:true}, function(){});
  });
  $('mShare').addEventListener('click', function(){ closeModal('menuModal'); shareReport(); });
  $('mWeek').addEventListener('click', function(){
    meta.weekStart = meta.weekStart === 0 ? 6 : 0; saveMeta();
    $('mWeekSub').textContent = 'حالياً: ' + WEEK_NAMES[meta.weekStart] + ' — اضغط للتبديل';
    renderReport();
    showToast('📅 الأسبوع يبدأ الآن يوم ' + WEEK_NAMES[meta.weekStart]);
  });
  $('mTheme').addEventListener('click', toggleTheme);
  $('mAbout').addEventListener('click', function(){
    closeModal('menuModal');
    askConfirm({
      icon:'ℹ️',
      title:'عن صلاحية',
      text:'صلاحية — تتبع تواريخ الانتهاء.\n\nالإصدار: 4.0\nالمطوّر: AwadLabs\n© 2026 جميع الحقوق محفوظة.\n\nهذا التطبيق محمي بموجب ترخيص خاص. لا يجوز نسخه أو تعديله أو توزيعه دون إذن كتابي.\n\ngithub.com/awadlabs',
      yes:'فهمت',
      info:true
    }, function(){});
  });
  $('mClearLog').addEventListener('click', function(){
    closeModal('menuModal');
    if(!log.length){ showToast('السجل فارغ بالفعل'); return; }
    askConfirm({icon:'🧹', title:'مسح سجل الإحصائيات؟', text:'سيُصفّر الرسم البياني (' + log.length + ' عملية). ستُحفظ نسخة يمكنك استعادتها من القائمة.', yes:'نعم، امسح السجل'}, function(){
      var snap = clearWithSnapshot('log');
      if(!snap){ showToast('⚠️ تعذر حفظ نسخة، لم يُمسح شيء. صدّر نسخة احتياطية أولاً'); return; }
      render(); showToast('🧹 تم مسح السجل', restoreSnapshot);
    });
  });
  $('mClearAll').addEventListener('click', function(){
    closeModal('menuModal');
    if(!items.length){ showToast('القائمة فارغة بالفعل'); return; }
    askConfirm({icon:'🗑️', title:'مسح كل المنتجات؟', text:'سيتم حذف ' + items.length + ' منتج (القوالب لن تتأثر). ستُحفظ نسخة تلقائية يمكنك استعادتها من القائمة.', yes:'نعم، امسح الكل'}, function(){
      var snap = clearWithSnapshot('items');
      if(!snap){ showToast('⚠️ تعذر حفظ نسخة، لم يُمسح شيء. صدّر نسخة احتياطية أولاً'); return; }
      render(); checkAlert(); updateNotice();
      showToast('🗑️ تم مسح ' + snap.items.length + ' منتج', restoreSnapshot);
    });
  });

  $('themeBtn').addEventListener('click', toggleTheme);
  $('shareReportBtn').addEventListener('click', shareReport);
  $('sortSeg').addEventListener('click', function(e){
    var b = e.target.closest('button'); if(!b) return;
    meta.sort = b.dataset.s; saveMeta(); renderSort(); render(); buzz(8);
  });

  ['addModal','confirmModal','deleteModal','menuModal','tplModal','printModal'].forEach(function(id){
    $(id).addEventListener('click', function(e){
      if(e.target === this){ closeModal(id); if(id === 'confirmModal') confirmAction = null; }
    });
  });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){
      Array.prototype.forEach.call(document.querySelectorAll('.overlay.open'), function(o){ closeModal(o.id); });
      confirmAction = null;
    }
  });

  var searchTimer;
  $('searchInput').addEventListener('input', function(){
    var v = this.value; clearTimeout(searchTimer);
    searchTimer = setTimeout(function(){ query = v; render(); }, 120);
  });
  $('filters').addEventListener('click', function(e){
    var b = e.target.closest('.chip'); if(!b) return;
    filter = b.dataset.f;
    Array.prototype.forEach.call(document.querySelectorAll('#filters .chip'), function(c){ c.classList.toggle('active', c === b); });
    $('listTitle').textContent = {all:'المنتجات', fresh:'المنتجات الطازجة', soon:'قريبة الانتهاء', expired:'المنتهية'}[filter];
    render();
  });
  $('catFilters').addEventListener('click', function(e){
    var b = e.target.closest('.chip'); if(!b) return;
    catFilter = b.dataset.c; renderCatFilters(); render();
  });

  $('alertClose').addEventListener('click', function(e){ e.stopPropagation(); $('alertBox').classList.remove('show'); });
  $('alertBox').addEventListener('click', function(){
    document.querySelector('#filters .chip[data-f="expired"]').click();
    $('list').scrollIntoView({behavior:'smooth', block:'start'});
  });

  window.addEventListener('scroll', function(){ $('fab').classList.toggle('show', window.scrollY > 260); }, {passive:true});
  var resizeTimer;
  window.addEventListener('resize', function(){ clearTimeout(resizeTimer); resizeTimer = setTimeout(renderReport, 150); });

  var lastDay = todayISO();
  function dayCheck(){
    var nowDay = todayISO();
    if(nowDay !== lastDay){ lastDay = nowDay; render(); checkAlert(); updateNotice(); }
  }
  document.addEventListener('visibilitychange', function(){
    if(document.visibilityState === 'visible'){ render(); dayCheck(); updateNotice(); }
  });
  setInterval(dayCheck, 60000);

  /* ---------- Init ---------- */
  load();
  loadMeta();
  var savedTheme = 'dark';
  try{ savedTheme = localStorage.getItem(THEME_KEY) || 'dark'; }catch(e){}
  applyTheme(savedTheme);
  renderCatFilters();
  renderSort();
  renderQuick();
  render();
  checkAlert();
  updateNotice();
  updateSoundLabel();
  requestPersist();
})();
</script>
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('./service-worker.js').catch(function(e){
        console.error('[salahiya] SW registration failed:', e);
      });
    });
  }
</script>
</body>
</html>