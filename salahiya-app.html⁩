  function saveItem(){
    var name = $('fName').value.trim(), date = $('fDate').value, prep = $('fPrep').value || todayISO();
    var dateOk = !!date && diffDays(prep, date) >= 0;
    $('errName').style.display = name ? 'none' : 'block';
    $('errDate').textContent = !date ? 'اختر تاريخ الانتهاء' : 'تاريخ الانتهاء يجب أن يكون بعد تاريخ التحضير';
    $('errDate').style.display = dateOk ? 'none' : 'block';
    if(!name || !dateOk){ buzz(40); return; }

    var data = {name:name, date:date, prep:prep, qty:$('fQty').value.trim(), notes:$('fNotes').value.trim(), photo:pendingPhoto, cat:formCat};
    var backupItems = JSON.stringify(items), backupTpl = JSON.stringify(templates), wasEdit = !!editingId, target;
    function apply(){
      if(wasEdit){
        target = items.find(function(x){ return x.id === editingId; });
        if(target) Object.assign(target, data);
      } else {
        target = Object.assign({id:uid(), created:Date.now()}, data);
        items.push(target);
      }
      if(saveAsTpl) upsertTemplate({name:name, days:diffDays(prep, date), cat:formCat, qty:data.qty});
    }
    apply();
    var photoDropped = false;
    if(!save()){
      items = JSON.parse(backupItems); templates = JSON.parse(backupTpl);
      if(!data.photo){ invalidateHistory(); return; }
      data.photo = null; apply(); photoDropped = true;
      if(!save()){ items = JSON.parse(backupItems); templates = JSON.parse(backupTpl); invalidateHistory(); return; }
    }
    buzz(15);
    if(target) flashId = target.id;
    closeModal('addModal');
    if(!wasEdit && items.length === 1) requestPersist();
    render(); renderQuick(); checkAlert(); updateNotice();
    var msg = photoDropped ? 'تم الحفظ بدون الصورة (الذاكرة ممتلئة)'
            : (wasEdit ? '✏️ تم تحديث "' + name + '"' : '✅ أُضيف "' + name + '"') + (saveAsTpl ? ' + قالب ⚡' : '');
    var tid = target ? target.id : null;
    showToast(msg, null, tid ? {label:'🖨️ طباعة', fn:function(){ openPrint(tid); }} : null);
  }

