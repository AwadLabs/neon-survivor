  function saveTplForm(){
    var name = $('tName').value.trim(), days = parseInt($('tDays').value, 10), err = '';
    if(!name) err = 'اكتب اسم القالب';
    else if(isNaN(days) || days < 0 || days > 365) err = 'اكتب مدة صلاحية بين 0 و365 يوماً';
    else {
      var dup = findTplByName(name);
      if(dup && dup.id !== tplEditId) err = 'يوجد قالب بنفس الاسم';
    }
    if(err){ $('tErr').textContent = err; $('tErr').style.display = 'block'; buzz(40); return; }
    var backup = JSON.stringify(templates), wasEdit = !!tplEditId;
    if(wasEdit){
      var t = templates.find(function(x){ return x.id === tplEditId; });
      if(t){ t.name = name; t.days = days; t.cat = tplCat; t.qty = $('tQty').value.trim(); }
    } else {
      templates.push({id:uid(), name:name, days:days, cat:tplCat, qty:$('tQty').value.trim(), uses:0, created:Date.now()});
    }
    if(!save()){ templates = JSON.parse(backup); invalidateHistory(); return; }
    buzz(15);
    showToast(wasEdit ? '✏️ تم تحديث القالب' : '⚡ أُضيف قالب "' + name + '"');
    resetTplForm(); renderTplList(); renderQuick();
  }

