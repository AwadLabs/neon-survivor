  function render(){
    var all = items.map(function(it){ var d = daysLeft(it.date); return {it:it, d:d, s:status(d)}; });
    var g = {expired:0, soon:0};
    all.forEach(function(e){ if(g[e.s] != null) g[e.s]++; });
    $('stTotal').textContent = all.length;
    $('stSoon').textContent = g.soon;
    $('stExpired').textContent = g.expired;

    var inCat = all.filter(function(e){ return catFilter === 'all' || e.it.cat === catFilter; });
    var counts = {all:inCat.length, fresh:0, soon:0, expired:0};
    inCat.forEach(function(e){ counts[e.s]++; });
    $('cAll').textContent = counts.all; $('cFresh').textContent = counts.fresh;
    $('cSoon').textContent = counts.soon; $('cExpired').textContent = counts.expired;

    var anyFuzzy = false;
    var view = inCat.filter(function(e){
      if(filter !== 'all' && e.s !== filter) return false;
      var sc = matchScore(e.it.name, query);
      if(sc === 1) anyFuzzy = true;
      return sc > 0;
    });
    view.sort(function(a,b){
      if(meta.sort === 'alpha') return cmpName(a.it.name, b.it.name) || (a.d - b.d);
      if(meta.sort === 'cat') return (catIndex(a.it.cat) - catIndex(b.it.cat)) || (a.d - b.d);
      return (a.d - b.d) || cmpName(a.it.name, b.it.name);
    });
    $('searchHint').style.display = (query.trim() && anyFuzzy) ? 'block' : 'none';

    var list = $('list');
    if(view.length === 0){
      list.innerHTML = items.length === 0
        ? '<div class="empty"><div class="e-icon">🧑‍🍳</div><h3>ابدأ بتقليل الهدر اليوم</h3>' +
          '<p>سجّل أول علبة في الثلاجة، أو أنشئ قالباً لما تحضّره يومياً لتضيفه بنقرة.</p>' +
          '<button class="btn primary" data-act="add">+ أضف أول منتج</button></div>'
        : '<div class="empty"><div class="e-icon">🔎</div><h3>لا توجد نتائج</h3><p>جرّب بحثاً أو فلتراً آخر</p></div>';
    } else if(meta.sort === 'cat'){
      var html = '', last = null;
      view.forEach(function(e){
        var key = catOf(e.it.cat) ? e.it.cat : '_none';
        if(key !== last){
          var c = catOf(e.it.cat);
          html += '<div class="group-h">' + (c ? c.icon + ' ' + c.label : '📦 بدون تصنيف') + '</div>';
          last = key;
        }
        html += cardHTML(e);
      });
      list.innerHTML = html;
    } else {
      list.innerHTML = view.map(cardHTML).join('');
    }
    flashId = null;
    renderReport();
  }

  /* ---------- Alerts & notices ---------- */
  function checkAlert(){
    var expired = 0, today = 0;
    items.forEach(function(it){ var d = daysLeft(it.date); if(d < 0) expired++; else if(d === 0) today++; });
    if(expired + today === 0){ $('alertBox').classList.remove('show'); return; }
    var parts = [];
    if(expired) parts.push(expired + ' منتج منتهي الصلاحية');
    if(today) parts.push(today + ' منتج ينتهي اليوم');
    $('alertTitle').textContent = 'انتبه! راجع الثلاجة الآن';
    $('alertText').textContent = parts.join(' و ') + ' — اضغط للعرض';
    $('alertBox').classList.add('show');
    buzz([120,80,120]);
  }

  /* ---------- Sound & haptics ---------- */
  var audioCtx = null, pendingAlert = false;
  function soundOn(){ return meta.sound !== false; }
  function getCtx(){
    if(!audioCtx){
      var AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return null;
      try{ audioCtx = new AC(); }catch(e){ return null; }
    }
    return audioCtx;
  }
  function tone(ctx, freq, at, dur, vol, type){
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type || 'sine';
    o.frequency.setValueAtTime(freq, at);
    g.gain.setValueAtTime(0.0001, at);
    g.gain.exponentialRampToValueAtTime(vol, at + 0.012);
    g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    o.connect(g); g.connect(ctx.destination);
    o.start(at); o.stop(at + dur + 0.02);
  }
  var SOUNDS = {
    tap: function(c, t){ tone(c, 1400, t, 0.04, 0.05, 'triangle'); },
    success: function(c, t){ tone(c, 784, t, 0.12, 0.14); tone(c, 1175, t + 0.09, 0.2, 0.14); },
    error: function(c, t){ tone(c, 220, t, 0.12, 0.1, 'sawtooth'); tone(c, 185, t + 0.14, 0.16, 0.1, 'sawtooth'); },
    alert: function(c, t){
      [0, 0.22, 0.44, 0.66].forEach(function(d, i){ tone(c, i % 2 ? 784 : 1047, t + d, 0.18, 0.15, 'square'); });
    }
  };
  function playSound(kind){
    if(!soundOn()) return;
    var ctx = getCtx(); if(!ctx) return;
    if(ctx.state !== 'running'){ if(kind === 'alert') pendingAlert = true; return; }
    try{ SOUNDS[kind](ctx, ctx.currentTime + 0.01); }catch(e){ console.error('[salahiya] sound failed:', e); }
  }
  function flushAlert(){
    if(pendingAlert){ pendingAlert = false; setTimeout(function(){ playSound('alert'); }, 120); }
  }
  function unlockAudio(){
    if(!soundOn()) return;
    var ctx = getCtx(); if(!ctx) return;
    if(ctx.state === 'running'){ flushAlert(); return; }
    ctx.resume().then(flushAlert).catch(function(){});
  }
  document.addEventListener('pointerdown', unlockAudio, true);
  document.addEventListener('touchend', unlockAudio, true);
  document.addEventListener('click', function(e){
    if(e.target.closest('button, .card, .photo-pick')) playSound('tap');
  }, true);

  function buzz(p){
    try{ if(navigator.vibrate) navigator.vibrate(p); }catch(e){}
    if(Array.isArray(p)) playSound('alert');
    else if(p >= 40) playSound('error');
    else if(p >= 15) playSound('success');
  }
  function updateSoundLabel(){
