  function updateNotice(){
    var now = Date.now(), base = meta.lastBackup || meta.firstUse;
    if(items.length && now - base > 7*DAY && now > (meta.backupSnooze || 0)){ showNotice('backup'); return; }
    if(!isStandalone() && now > (meta.installSnooze || 0)){ showNotice('install'); return; }
    hideNotice();
  }

  /* ---------- Report & chart ---------- */
  function weekData(n){
    var ws = weekStart(new Date()), out = [];
    for(var i=0;i<n;i++){
      var start = new Date(ws); start.setDate(ws.getDate() - 7*i);
      var end = new Date(start); end.setDate(start.getDate() + 7);
      var w = {start:start, wasted:0, used:0};
      log.forEach(function(l){ if(l.at >= start.getTime() && l.at < end.getTime()) w[l.outcome === 'wasted' ? 'wasted' : 'used']++; });
      out.push(w);
    }
    return out;
  }
  function stats30(){
    var since = Date.now() - 30*DAY, wasted = 0, used = 0, byName = {};
    log.forEach(function(l){
      if(l.at < since) return;
      if(l.outcome === 'wasted'){ wasted++; byName[l.name] = (byName[l.name]||0) + 1; } else used++;
    });
    var top = Object.keys(byName).sort(function(a,b){ return byName[b]-byName[a]; }).slice(0,3).map(function(k){ return {name:k, n:byName[k]}; });
    return {wasted:wasted, used:used, rate:(wasted+used) ? Math.round(wasted*100/(wasted+used)) : null, top:top};
  }
  function renderReport(){
    var weeks = weekData(6), s = stats30();
    $('rWeek').textContent = weeks[0].wasted;
    $('rMonth').textContent = s.wasted;
    $('rRate').textContent = s.rate == null ? '—' : s.rate + '%';
    $('rWeekStart').textContent = 'الأسبوع يبدأ يوم ' + WEEK_NAMES[meta.weekStart];
    $('reportEmpty').style.display = log.length ? 'none' : 'block';
    drawChart(weeks);
  }
  function drawChart(weeks){
    var cv = $('chart'), w = cv.clientWidth || 300, h = 190, dpr = window.devicePixelRatio || 1;
    cv.width = w * dpr; cv.height = h * dpr;
    var ctx = cv.getContext('2d');
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.clearRect(0,0,w,h);
    var cs = getComputedStyle(document.documentElement);
    var cRed = cs.getPropertyValue('--red').trim(), cGreen = cs.getPropertyValue('--green').trim();
    var cMuted = cs.getPropertyValue('--muted').trim(), cBorder = cs.getPropertyValue('--border').trim();
    var font = getComputedStyle(document.body).fontFamily;
    var max = 1;
    weeks.forEach(function(k){ max = Math.max(max, k.wasted, k.used); });
    var top = 22, bottom = h - 30, chartH = bottom - top, slot = w / weeks.length;
    ctx.strokeStyle = cBorder; ctx.lineWidth = 1;
    if(ctx.setLineDash) ctx.setLineDash([3,4]);
    for(var gl=1; gl<=3; gl++){
      var gy = Math.round(bottom - chartH * gl/3) + .5;
      ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(w,gy); ctx.stroke();
    }
    if(ctx.setLineDash) ctx.setLineDash([]);
    ctx.beginPath(); ctx.moveTo(0,bottom+.5); ctx.lineTo(w,bottom+.5); ctx.stroke();
    function rr(x,y,bw,bh,r){
      r = Math.min(r, bw/2, bh);
      ctx.beginPath(); ctx.moveTo(x, y+bh); ctx.lineTo(x, y+r);
      ctx.quadraticCurveTo(x, y, x+r, y); ctx.lineTo(x+bw-r, y);
      ctx.quadraticCurveTo(x+bw, y, x+bw, y+r); ctx.lineTo(x+bw, y+bh); ctx.closePath(); ctx.fill();
    }
    ctx.textAlign = 'center';
    try{ ctx.direction = 'rtl'; }catch(e){}
    weeks.forEach(function(k, i){
      var cx = slot*i + slot/2, bw = Math.max(8, Math.min(18, slot/3.4));
      [[k.wasted, cRed, cx + 2], [k.used, cGreen, cx - 2 - bw]].forEach(function(b){
        var v = b[0], bh = v ? Math.max(4, v/max*chartH) : 2;
        ctx.fillStyle = b[1]; ctx.globalAlpha = v ? 1 : .3;
        rr(b[2], bottom - bh, bw, bh, 5);
        ctx.globalAlpha = 1;
        if(v){ ctx.font = '700 11px ' + font; ctx.fillText(v, b[2] + bw/2, bottom - bh - 5); }
      });
      ctx.fillStyle = cMuted; ctx.font = (i===0 ? '700 ' : '400 ') + '11px ' + font;
      ctx.fillText(i === 0 ? 'هذا الأسبوع' : (k.start.getDate() + '/' + (k.start.getMonth()+1)), cx, h - 8);
    });
  }
  function buildReportText(){
    var wk = weekData(1)[0], s = stats30(), expired = [], soon = [];
    items.forEach(function(it){
      var d = daysLeft(it.date);
      if(d <= 0) expired.push(it.name); else if(d <= 3) soon.push(it.name + ' (' + remainingText(d) + ')');
    });
    var lines = ['📊 تقرير الهدر — صلاحية', '📅 ' + new Date().toLocaleDateString('ar', {weekday:'long', day:'numeric', month:'long', year:'numeric'}), ''];
    lines.push('هذا الأسبوع (من ' + WEEK_NAMES[meta.weekStart] + ' ' + wk.start.getDate() + '/' + (wk.start.getMonth()+1) + '): ' + wk.wasted + ' تالف، ' + wk.used + ' مستخدم');
    lines.push('آخر 30 يوماً: ' + s.wasted + ' تالف من ' + (s.wasted + s.used) + (s.rate != null ? ' (نسبة الهدر ' + s.rate + '%)' : ''));
    if(s.top.length) lines.push('الأكثر تلفاً: ' + s.top.map(function(t){ return t.name + ' ×' + t.n; }).join('، '));
    lines.push('');
    lines.push('⛔ منتهي الآن (' + expired.length + '): ' + (expired.join('، ') || 'لا يوجد'));
    lines.push('⏳ ينتهي خلال 3 أيام (' + soon.length + '): ' + (soon.join('، ') || 'لا يوجد'));
    return lines.join('\n');
  }
  function shareReport(){
